{
  "name": "ha-mos-card",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "yarn@4.12.0",
  "description": "Lovelace card for the MOS NAS Home Assistant integration",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "mos",
    "nas",
    "docker",
    "lxc",
    "proxmox"
  ],
  "module": "ha-mos-card.js",
  "repository": "git@github.com:anym001/ha-mos-card.git",
  "author": "anym001",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "home-assistant-js-websocket": "9.6.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^19.6.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^1.1.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "yarn clean && yarn lint && yarn rollup",
    "check": "yarn lint && yarn typecheck && yarn lint:md && yarn lint:format && yarn build",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:format": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "rollup": "rollup -c",
    "setup": "yarn install && pre-commit install || echo 'pre-commit not found - install it (https://pre-commit.com/#install) and rerun `yarn setup`'",
    "start": "rollup -c rollup.config.dev.js --watch",
    "typecheck": "tsc --noEmit"
  }
}
